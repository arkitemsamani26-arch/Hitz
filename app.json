{
  "expo": {
    "name": "Hits",
    "slug": "hits",
    "version": "0.1.0",
    "scheme": "hits",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1220",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.hits.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Hits uses your approximate location to find players near you. Other players only ever see a rough distance, never where you are."
      }
    },
    "android": {
      "package": "app.hits.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser"],
    "experiments": { "typedRoutes": false }
  }
}
