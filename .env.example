# Copy to .env to run against the live Supabase project (created 2026-09-19, us-west-1).
# These are the publishable client keys; they are meant to ship in the app. Never put the
# service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://pvkzcbgpbebllnzmxxwg.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_N3jxAseqoAtNC1bolDKoJQ_KXGKf6Zf
# Leave unset (or 0) to use Supabase; set to 1 for the in-memory demo.
EXPO_PUBLIC_DEMO=0

# UTR Engage API, client side. Until both are set, "Link UTR" says so honestly instead of
# opening a broken flow. The secret half (UTR_CLIENT_SECRET, UTR_TOKEN_URL,
# UTR_PROFILE_URL, UTR_PROFILE_FIELDS, APP_URL) lives on the edge functions and must never
# appear in this file -- anything EXPO_PUBLIC_ ships inside the app bundle.
EXPO_PUBLIC_UTR_AUTH_URL=
EXPO_PUBLIC_UTR_CLIENT_ID=
